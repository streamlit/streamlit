{
  // ==============================================
  // PYTHON TESTING CONFIGURATION
  // ==============================================

  // Enable pytest for Python testing
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,

  // Global pytest configuration (discovers both e2e and unit tests)
  "python.testing.pytestArgs": [
    "lib/tests",
    "e2e_playwright",
    "-v",
    "--tb=short",
    "--disable-warnings",
    "--no-cov"
  ],
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.autoTestDiscoverOnSaveEnabled": true,

  // Use workspace-relative path for portability across all developers
  "python.defaultInterpreterPath": "${workspaceFolder}/lib/venv/bin/python",
  "python.pythonPath": "${workspaceFolder}/lib/venv/bin/python",

  // Python analysis and paths (this handles PYTHONPATH automatically)
  "python.terminal.activateEnvironment": true,
  "python.testing.debugPort": 5678,

  // Additional test discovery settings
  "python.testing.promptToConfigure": false,
  "python.analysis.extraPaths": ["${workspaceFolder}/lib"],

  // Environment variables for test discovery and execution
  "python.terminal.activateEnvInCurrentTerminal": true,

  // Set PYTHONPATH for test discovery and execution
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}/lib"
  },
  "terminal.integrated.env.osx": {
    "PYTHONPATH": "${workspaceFolder}/lib"
  },
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder}/lib"
  },

  // ==============================================
  // GENERAL CONFIGURATION
  // ==============================================

  // File associations
  "files.associations": {
    "*_test.py": "python",
    "test_*.py": "python",
    "*.test.ts": "typescript",
    "*.test.tsx": "typescriptreact",
    "*.spec.ts": "typescript",
    "*.spec.tsx": "typescriptreact"
  },

  // Test UI and discovery settings
  "python.testing.showTestOutputDebugConsole": true,
  "testExplorer.useNativeTesting": true,
  "python.testing.openOutputPanel": true,
  "python.testing.showTestResultOnFailure": true,
  "test.defaultGutterClickAction": "run",
  "testing.openTesting": "neverOpen",

  // Editor settings for test files
  "editor.rulers": [88],
  "editor.formatOnSave": true,

  // Language-specific settings
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "testing.automaticallyOpenTestResults": "neverOpen"
}
