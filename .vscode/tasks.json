{
  "version": "2.0.0",
  "tasks": [
    // ==============================================
    // E2E PLAYWRIGHT TESTS
    // ==============================================
    // NOTE: These tasks use make commands which rely on centralized configurations:
    // - pytest arguments are defined in e2e_playwright/pytest.ini
    // - make targets add only command-specific overrides
    {
      "label": "Run E2E Test",
      "type": "shell",
      "command": "make",
      "args": ["run-e2e-test", "${fileBasenameNoExtension}.py"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/lib"
        }
      }
    },
    {
      "label": "Debug E2E Test",
      "type": "shell",
      "command": "make",
      "args": ["debug-e2e-test", "${fileBasenameNoExtension}.py"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/lib",
          "PWDEBUG": "1"
        }
      }
    },

    // ==============================================
    // PYTHON UNIT TESTS
    // ==============================================
    // NOTE: Python unit test arguments are centralized in lib/pytest.ini
    // These tasks only add the file path and any task-specific overrides
    {
      "label": "Run Python Unit Test",
      "type": "shell",
      "command": "${workspaceFolder}/lib/venv/bin/python",
      "args": ["-m", "pytest", "${file}", "--no-cov", "-v", "--tb=short"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/lib"
        }
      }
    },
    {
      "label": "Run Python Tests (All)",
      "type": "shell",
      "command": "make",
      "args": ["python-tests"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/lib"
        }
      }
    },

    // ==============================================
    // TYPESCRIPT TESTS
    // ==============================================
    {
      "label": "Run TypeScript Test",
      "type": "shell",
      "command": "yarn",
      "args": ["test", "${relativeFile}"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      }
    },
    {
      "label": "Run Frontend Tests (All)",
      "type": "shell",
      "command": "make",
      "args": ["frontend-tests"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
