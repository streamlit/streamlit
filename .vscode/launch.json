{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    // ==============================================
    // STREAMLIT APP DEBUGGING
    // ==============================================
    {
      "name": "Debug Streamlit App",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "${file}"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib"
      }
      // allows to set breakpoints in installed packages, such as the Streamlit lib itself or custom component code etc.
      // "justMyCode": false,
      // allows to use a different installed version of streamlit in another venv folder, e.g.
      // "program": "~/Projects/streamlit/lib/venv/bin/pytest"
    },

    // ==============================================
    // E2E PLAYWRIGHT TESTS
    // ==============================================
    {
      "name": "Run E2E Test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "--tracing",
        "retain-on-failure",
        "--reruns",
        "0",
        "--output",
        "./e2e_playwright/test-results/",
        "--video",
        "retain-on-failure",
        "--screenshot",
        "only-on-failure",
        "--full-page-screenshot",
        "-r",
        "aR",
        "-v",
        "--durations=5",
        "--reruns-delay",
        "1",
        "--rerun-except",
        "Missing snapshot",
        "--tb=short"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Debug E2E Test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "--tracing",
        "on",
        "--reruns",
        "0",
        "--output",
        "./e2e_playwright/test-results/",
        "--video",
        "on",
        "--screenshot",
        "on",
        "--full-page-screenshot",
        "-r",
        "aR",
        "-v",
        "-s",
        "--durations=5",
        "--reruns-delay",
        "1",
        "--rerun-except",
        "Missing snapshot",
        "--tb=short"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib",
        "PWDEBUG": "1"
      },
      "console": "integratedTerminal"
    },

    // ==============================================
    // PYTHON UNIT TESTS
    // ==============================================
    {
      "name": "Run Python Unit Test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "--tb=short"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Python Unit Test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "-s", "--tb=short"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib"
      },
      "console": "integratedTerminal"
    },

    // ==============================================
    // TYPESCRIPT TESTS
    // ==============================================
    {
      "name": "Run TypeScript Test",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/node_modules/.bin/vitest",
      "args": ["run", "${file}"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug TypeScript Test",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/node_modules/.bin/vitest",
      "args": ["run", "${file}", "--inspect-brk"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    }
  ]
}
