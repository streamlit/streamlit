{
  "plansDirectory": "./work-tmp",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run streamlit *)",
      "Bash(uv run mypy *)",
      "Bash(uv run ty *)",
      "Bash(uv run pre-commit *)",
      "Bash(uv sync *)",
      "Bash(uv pip *)",
      "Bash(yarn *)",
      "Bash(gh *)",
      "Bash(git *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre_bash_redirect.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop_check.sh",
            "timeout": 120,
            "statusMessage": "Running make check (fast)..."
          }
        ]
      }
    ]
  }
}
