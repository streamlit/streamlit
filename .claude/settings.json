{
  "permissions": {
    "allow": [
      "Read(**)", "Write", "Edit", "Glob", "Grep", "Bash"
    ],
    "ask": [],
    "deny": []
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/stop_hook.py",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre_bash_redirect.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
