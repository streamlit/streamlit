{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "uv run python \"$CURSOR_PROJECT_DIR/scripts/log_agent_metrics.py\" skill_invocation cursor_task_tool",
        "timeout": 5,
        "matcher": "Task"
      }
    ],
    "subagentStart": [
      {
        "command": "uv run python \"$CURSOR_PROJECT_DIR/scripts/log_agent_metrics.py\" subagent_invocation",
        "timeout": 5
      }
    ]
  }
}
