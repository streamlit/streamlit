{
  "name": "@streamlit/shared",
  "version": "1.52.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/streamlit-shared.cjs.js",
  "module": "./dist/streamlit-shared.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/streamlit-shared.es.js",
      "require": "./dist/streamlit-shared.cjs.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --max-warnings 0 src",
    "format": "prettier --write --config ../.prettierrc --ignore-path ../.prettierignore './src/**/*.{js,ts,tsx}'",
    "formatCheck": "prettier --check --cache --config ../.prettierrc --ignore-path ../.prettierignore './src/**/*.{js,ts,tsx}'"
  },
  "dependencies": {
    "@emotion-icons/material-outlined": "^3.14.0",
    "@emotion-icons/material-rounded": "^3.14.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.14.1",
    "@sindresorhus/slugify": "^3.0.0",
    "@streamlit/protobuf": "workspace:^",
    "@streamlit/theme": "workspace:^",
    "@streamlit/utils": "workspace:^",
    "baseui": "12.2.0",
    "color2k": "^2.0.2",
    "katex": "^0.16.25",
    "lodash-es": "^4.17.22",
    "loglevel": "^1.9.2",
    "mdast-util-find-and-replace": "^3.0.2",
    "react-feather": "^2.0.10",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "styletron-react": "^6.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "xxhashjs": "^0.2.2"
  },
  "devDependencies": {
    "@streamlit/typescript-config": "workspace:^",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/lodash-es": "~4.17.12",
    "@types/react": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.5",
    "@types/xxhashjs": "^0.2.2",
    "@vitest/eslint-plugin": "^1.3.2",
    "eslint": "^9.39.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.0.2",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
