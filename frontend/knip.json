{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": ["-lintignore"],
  "ignoreBinaries": ["streamlit"],
  "ignoreUnresolved": ["^\\./proto(?:\\.js)?$"],
  "ignoreIssues": {
    "component-lib/src/ArrowTable.ts": ["exports", "types"]
  },
  "ignoreDependencies": [
    "@swc/plugin-emotion",
    "eslint-plugin-streamlit-custom",
    "oxfmt",
    "typescript-v7"
  ],
  "rules": {
    "unlisted": "off"
  },
  "workspaces": {
    ".": {
      "entry": ["vitest.setup.ts"]
    }
  }
}
