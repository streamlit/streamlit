{
  "name": "@streamlit/chat",
  "version": "1.52.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/streamlit-chat.cjs.js",
  "module": "./dist/streamlit-chat.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/streamlit-chat.es.js",
      "require": "./dist/streamlit-chat.cjs.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --max-warnings 0 src",
    "format": "prettier --write --config ../.prettierrc --ignore-path ../.prettierignore './src/**/*.{js,ts,tsx}'",
    "formatCheck": "prettier --check --cache --config ../.prettierrc --ignore-path ../.prettierignore './src/**/*.{js,ts,tsx}'"
  },
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "@streamlit/connection": "workspace:^",
    "@streamlit/core": "workspace:^",
    "@streamlit/protobuf": "workspace:^",
    "@streamlit/shared": "workspace:^",
    "@streamlit/theme": "workspace:^",
    "@streamlit/utils": "workspace:^",
    "color2k": "^2.0.2"
  },
  "devDependencies": {
    "@streamlit/typescript-config": "workspace:^",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.0",
    "@vitest/eslint-plugin": "^1.3.2",
    "eslint": "^9.39.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.0.2",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
