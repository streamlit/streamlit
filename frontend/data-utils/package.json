{
  "name": "@streamlit/data-utils",
  "version": "1.52.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/streamlit-data-utils.cjs.js",
  "module": "./dist/streamlit-data-utils.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/streamlit-data-utils.es.js",
      "require": "./dist/streamlit-data-utils.cjs.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --max-warnings 0 src",
    "format": "prettier --write --config ../.prettierrc --ignore-path ../.prettierignore './src/**/*.{js,ts,tsx}'",
    "formatCheck": "prettier --check --cache --config ../.prettierrc --ignore-path ../.prettierignore './src/**/*.{js,ts,tsx}'"
  },
  "dependencies": {
    "@streamlit/protobuf": "workspace:^",
    "@streamlit/utils": "workspace:^",
    "apache-arrow": "^21.1.0",
    "immer": "^11.1.3",
    "lodash-es": "^4.17.22",
    "loglevel": "^1.9.2",
    "moment": "^2.30.1",
    "moment-duration-format": "^2.3.2",
    "moment-timezone": "^0.6.0",
    "numbro": "^2.5.0",
    "sprintf-js": "^1.1.3",
    "xxhashjs": "^0.2.2"
  },
  "devDependencies": {
    "@streamlit/typescript-config": "workspace:^",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/lodash-es": "~4.17.12",
    "@types/moment-duration-format": "~2.2.7",
    "@types/sprintf-js": "^1.1.4",
    "@types/xxhashjs": "^0.2.2",
    "eslint": "^9.39.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.0.2",
    "vitest": "^4.0.16"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
