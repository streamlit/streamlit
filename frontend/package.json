{
  "name": "streamlit",
  "version": "1.52.2",
  "private": true,
  "workspaces": [
    "app",
    "component-v2-lib",
    "connection",
    "core",
    "data-utils",
    "eslint-plugin-streamlit-custom",
    "lib",
    "protobuf",
    "render-tree",
    "shared",
    "theme",
    "typescript-config",
    "utils"
  ],
  "scripts": {
    "start": "yarn workspace @streamlit/app start",
    "buildWithProfiler": "yarn workspace @streamlit/app buildWithProfiler",
    "build": "turbo run build",
    "test": "turbo run test",
    "testWatch": "vitest",
    "testCoverage": "vitest run --coverage",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "formatCheck": "turbo run formatCheck"
  },
  "resolutions": {
    "d3-color": "^3.1.0",
    "dompurify": "^3.2.4",
    "prismjs": "^1.30.0",
    "@protobufjs/inquire@npm:^1.1.0": "patch:@protobufjs/inquire@npm%3A1.1.0#~/.yarn/patches/@protobufjs-inquire-npm-1.1.0-3c7759e9ce.patch",
    "@swc/core": "^1.15.3"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "packageManager": "yarn@4.5.3",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.16",
    "concurrently": "^9.2.1",
    "jiti": "^2.6.1",
    "turbo": "^2.3.0",
    "vitest": "^4.0.16"
  }
}
