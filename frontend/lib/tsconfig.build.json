{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "src/*": ["./src/*"],
      "~lib/*": ["./src/*"],
      "@streamlit/component-v2-lib": ["../component-v2-lib/src/index.d.ts"],
      "@streamlit/connection": ["../connection/src/index.d.ts"],
      "@streamlit/lib": ["./src"],
      "@streamlit/lib/testing": ["./src/testing.ts"],
      "@streamlit/protobuf": ["../protobuf/proto.d.ts"],
      "@streamlit/utils": ["../utils/src/index.d.ts"]
    }
  },
  "include": ["src/**/*", "declarations.d.ts", "emotion.d.ts"]
}
