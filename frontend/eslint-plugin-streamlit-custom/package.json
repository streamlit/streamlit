    "eslint": "^9.30.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^3.2.4"
  },
