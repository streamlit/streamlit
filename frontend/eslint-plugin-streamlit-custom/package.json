{
  "name": "eslint-plugin-streamlit-custom",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/eslint-plugin-streamlit-custom.es.js",
  "module": "./dist/eslint-plugin-streamlit-custom.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/eslint-plugin-streamlit-custom.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "buildWatch": "vite build --watch",
    "format": "prettier --write --config ../.prettierrc --ignore-path ../.prettierignore './src/**/*.{js,ts,jsx,tsx}'",
    "formatCheck": "prettier --check --config ../.prettierrc --ignore-path ../.prettierignore './src/**/*.{js,ts,jsx,tsx}'",
    "lint": "eslint --max-warnings 0 src",
    "test": "vitest run",
    "testWatch": "vitest",
    "typecheck": "tsc --noEmit",
    "typesync:ci": "typesync --dry=fail",
    "typesync": "typesync"
  },
  "devDependencies": {
    "@typescript-eslint/rule-tester": "^8.0.0",
    "@typescript-eslint/types": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.1",
    "prettier": "^3.5.3",
    "typescript": "^5.0.0",
    "typesync": "^0.14.3",
    "vite": "^7.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@typescript-eslint/utils": "^8.0.0"
  }
}
