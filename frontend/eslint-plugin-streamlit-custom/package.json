  "version": "1.0.0",
  "type": "module",
  "main": "./dist/eslint-plugin-streamlit-custom.cjs.js",
  "module": "./dist/eslint-plugin-streamlit-custom.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
